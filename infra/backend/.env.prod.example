# Copie para .env.prod SOMENTE no servidor e preencha os valores.
# PostgreSQL na mesma VM, pelo nome do serviço na rede lions-internal.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lionsdb
SPRING_DATASOURCE_USERNAME=lions
# Mesmo valor de APP_DB_PASSWORD em /opt/lions/database/.env.database.
SPRING_DATASOURCE_PASSWORD='SUBSTITUA_POR_UMA_SENHA_APP_FORTE'
LIONS_JWT_SECRET='SUBSTITUA_POR_BASE64_DE_PELO_MENOS_32_BYTES'
LIONS_ADMIN_USERNAME=marcio
LIONS_ADMIN_PASSWORD='SUBSTITUA_POR_UMA_SENHA_FORTE'
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
