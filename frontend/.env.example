# Copie para .env.local (fora do git) para sobrescrever os valores só na sua máquina.

# Prefixo de todas as chamadas à API (relativo; funciona atrás do NGINX).
# VITE_API_URL=/api/v1

# true = dados de exemplo (mocks); false = API real.
# VITE_USE_MOCKS=true

# Só no `npm run dev`: para onde o Vite repassa /api.
# VITE_BACKEND_URL=http://localhost:8080

# Validade do token de exemplo, em segundos (padrão 1800). Encurte para testar a renovação e a
# expiração com 120 ou mais (ex.: 150); com 60 ou menos o token vence antes da próxima renovação
# permitida (no máximo uma a cada 60 s).
# VITE_MOCK_TOKEN_TTL_SECONDS=1800

# Atraso artificial das respostas de exemplo, em ms (padrão 400; os testes usam 0).
# VITE_MOCK_DELAY_MS=400
